# 复制为 .env 后按需修改：cp .env.example .env
# pydantic-settings 会自动读取，未设置的值使用 app/core/config.py 里的默认值。

APP_NAME=MathTeam API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
API_PREFIX=/api/v1

# 前端地址，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 生产环境务必改成随机长字符串，例如 openssl rand -hex 32
SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL 数据库；密码为空时只填写用户名
DATABASE_URL=postgresql+psycopg://zhengrui@localhost:5432/mathteam

# 开发期自动建表；生产建议 false 并用 alembic upgrade head
AUTO_CREATE_TABLES=true
# 生产环境必须设为 false，避免写入演示账号和演示数据
SEED_DEMO_DATA=true

# 团队聊天附件：本地临时目录和单文件上限（默认 50 MB）；保留时长固定为 24 小时
CHAT_UPLOAD_DIR=uploads/chat
CHAT_ATTACHMENT_MAX_BYTES=52428800
CHAT_ATTACHMENT_CLEANUP_INTERVAL_SECONDS=900
